{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "MongoLogging": {
    "ConnectionString": "",
    "DatabaseName": "atlas_logs",
    "CollectionName": "application_logs",
    "EnableInformation": false
  },
  "Jwt": {
    "Key": "Atlas-Dev-Secret-Key-Min-32-Chars!!",
    "Issuer": "Atlas.Api",
    "Audience": "Atlas.Client",
    "ExpirationMinutes": 60
  }
}
