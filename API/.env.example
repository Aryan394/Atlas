ConnectionStrings__DefaultConnection=

# MongoDB Atlas cluster (application logs). Leave empty to disable Mongo logging.
MongoLogging__ConnectionString=mongodb+srv://[USER]:[PASSWORD]@[CLUSTER].mongodb.net/?appName=Atlas
MongoLogging__DatabaseName=atlas_logs
MongoLogging__CollectionName=application_logs
# Set to true only when you want INFO logs written to MongoDB
MongoLogging__EnableInformation=false
